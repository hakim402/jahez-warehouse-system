# Mainland China region (Alibaba Cloud ECS). Copy to cn-mainland.env, fill in secrets, keep out of git.
# Supplied at deploy time:  docker compose --env-file env/cn-mainland.env up -d
ENV_FILE=env/cn-mainland.env

# PostgreSQL — independent database per region
POSTGRES_DB=jahez_warehouse_db
POSTGRES_USER=jahez
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
MIGRATION_DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000

# Auth
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# Storage — mainland uses Alibaba Cloud OSS
STORAGE_DRIVER=oss
STORAGE_MAX_UPLOAD_MB=15
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# Invoice AI — mainland uses Qwen OCR via Model Studio (OpenAI-compatible endpoint)
DEPLOYMENT_PROFILE=cn-mainland
INVOICE_AI_PROVIDER=qwen
INVOICE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INVOICE_AI_MODEL=qwen-vl-ocr
INVOICE_AI_API_KEY=
INVOICE_AI_TIMEOUT_MS=30000

# Nginx / TLS
DOMAIN=app.example.cn
TLS_CERT=fullchain.pem
TLS_KEY=privkey.pem
MAX_UPLOAD_MB=15
TLS_CERT_DIR=./tls
WEB_ROOT=./www
NGINX_CONF=./nginx/jahez.conf

# Backups — region-local off-server target
BACKUP_REGION=cn-mainland
BACKUP_DIR=/var/backups/jahez
BACKUP_STORAGE_DIR=/data/storage
