# International region (Hostinger). Copy to international.env, fill in secrets, keep it out of git.
# Supplied at deploy time:  docker compose --env-file env/international.env up -d
ENV_FILE=env/international.env

# PostgreSQL — independent database per region
POSTGRES_DB=jahez_warehouse_db
POSTGRES_USER=jahez
POSTGRES_PASSWORD=CHANGE_ME
# Inside compose the host is the `postgres` service. For least privilege create a separate runtime
# role for DATABASE_URL and keep MIGRATION_DATABASE_URL on the owner role (see deploy/RUNBOOK.md).
DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
MIGRATION_DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000

# Auth
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# Storage — international uses S3-compatible object storage
STORAGE_DRIVER=s3
STORAGE_MAX_UPLOAD_MB=15
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Invoice AI — international uses DeepSeek
DEPLOYMENT_PROFILE=international
INVOICE_AI_PROVIDER=deepseek
INVOICE_AI_BASE_URL=https://api.deepseek.com
INVOICE_AI_MODEL=deepseek-flash
INVOICE_AI_API_KEY=
DEEPSEEK_API_KEY=
INVOICE_AI_TIMEOUT_MS=30000

# Nginx / TLS
DOMAIN=app.example.com
TLS_CERT=fullchain.pem
TLS_KEY=privkey.pem
MAX_UPLOAD_MB=15
TLS_CERT_DIR=./tls
WEB_ROOT=./www
NGINX_CONF=./nginx/jahez.conf

# Backups — off-server target
BACKUP_REGION=international
BACKUP_DIR=/var/backups/jahez
BACKUP_STORAGE_DIR=/data/storage
