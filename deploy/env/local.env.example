# Local single-host profile for development and rehearsal. Copy to local.env and fill in.
# Supplied at deploy time:  docker compose --env-file env/local.env up -d
ENV_FILE=env/local.env

# PostgreSQL
POSTGRES_DB=jahez_warehouse_db
POSTGRES_USER=jahez
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
MIGRATION_DATABASE_URL=postgresql://jahez:CHANGE_ME@postgres:5432/jahez_warehouse_db
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000

# Auth
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# Storage — local private disk (the storage volume mounted at /data/storage)
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_MB=15

# Invoice AI — deterministic sample extractor: no network, no real invoice data leaves the machine
DEPLOYMENT_PROFILE=international
INVOICE_AI_PROVIDER=sample
INVOICE_AI_TIMEOUT_MS=30000

# Nginx / TLS (local self-signed for rehearsal)
DOMAIN=localhost
TLS_CERT=fullchain.pem
TLS_KEY=privkey.pem
MAX_UPLOAD_MB=15
TLS_CERT_DIR=./tls
WEB_ROOT=./www
NGINX_CONF=./nginx/jahez.conf

# Backups — local rehearsal target
BACKUP_REGION=local
BACKUP_DIR=./backups
BACKUP_STORAGE_DIR=/data/storage
