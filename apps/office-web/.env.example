# Public browser setting for the same-origin API route
VITE_API_BASE_URL=/api/v1

# Optional public IDs for the Jahez tenant and a known assigned warehouse.
VITE_TENANT_ID=
VITE_DEFAULT_WAREHOUSE_ID=

# Local Vite proxy target. This setting is not exposed to browser code.
JAHEZ_DEV_API_TARGET=http://127.0.0.1:3000
