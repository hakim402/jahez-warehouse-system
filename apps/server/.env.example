# Server
PORT=3000
DEPLOYMENT_PROFILE=international

# PostgreSQL and authentication
# DATABASE_URL is the least-privilege API/worker runtime role; it must not change schema.
# Runtime grants: USAGE on schema public and scoped DML on application tables.
# Grant only SELECT/INSERT on audit_events, stock_movements, files, dispatches, dispatch_lines,
# dispatch_allocations, stock_adjustments, and expenses; SELECT/INSERT/UPDATE on expense_categories;
# and USAGE on the sync sequence.
# Migrations grant privileged auth and receiving functions to the DATABASE_URL role.
# MIGRATION_DATABASE_URL is the migration role used only by the migrate entry point.
# Database URL format is postgresql://USER:PASSWORD@127.0.0.1:5432/jahez
DATABASE_URL=postgresql://jahez_app:CHANGE_ME@127.0.0.1:5432/jahez_warehouse_db
MIGRATION_DATABASE_URL=postgresql://jahez_migrator:CHANGE_ME@127.0.0.1:5432/jahez_warehouse_db
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000
JWT_SECRET=

# Storage: local (private VPS disk, default), s3 (S3-compatible), or oss (Alibaba OSS).
# Each file records its provider and object key, so earlier uploads stay readable after switching.
# Local storage path is relative to apps/server and must stay outside the web root.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
STORAGE_MAX_UPLOAD_MB=15

# S3-compatible provider (required when STORAGE_DRIVER=s3; keep configured to read earlier S3 files)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional custom endpoint for S3-compatible services; path-style addressing when true
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Alibaba OSS provider (required when STORAGE_DRIVER=oss; keep configured to read earlier OSS files)
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=

# Direct DeepSeek API for local development
INVOICE_AI_PROVIDER=deepseek
INVOICE_AI_BASE_URL=https://api.deepseek.com
INVOICE_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
